# Hermes AI 官方仓库地址
# 示例只是占位，请改成你确认的官方地址
HERMES_REPO_URL=https://example.com/official/hermes.git

# 分支、tag 或 commit
HERMES_REF=main

# 本地安装目录
HERMES_DIR=./runtime/hermes

# 默认服务端口
HERMES_PORT=7860

# 是否优先使用 Docker Compose：true / false
PREFER_DOCKER=true

# 可选：Python 虚拟环境目录
PYTHON_VENV=.venv

# 可选：启动命令。留空时脚本会自动猜测
CUSTOM_START_CMD=
